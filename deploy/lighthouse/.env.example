# Lung3D 轻量服务器环境变量模板
# 使用：cp .env.example .env  然后填入真实值
# ⚠️ .env 含密钥，切勿提交 git（确保 .gitignore 已忽略 .env）

# 镜像地址（留空则用本地 lung3d-web:latest）
# 例：ccr.ccs.tencentyun.com/<命名空间>/<服务名>:latest
LUNG3D_IMAGE=

# 微信小程序 appid / secret（用于 /api/wxacode 生成小程序码）
WX_APPID=
WX_SECRET=

# 以下为可选覆盖项，不填则用 docker-compose.yml 中的默认值
# MESH_DS_FACTOR=3
# WALL_DS_FACTOR=4
# MAX_CONCURRENT_PROCESSING=1
# DISTAL_PRUNE_MM=1.0
# CASE_EXPIRE_DAYS=30
