<view class="page">
  <canvas type="webgl" id="webgl" class="canvas"
          bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd"></canvas>

  <view class="loading" wx:if="{{loading}}">模型加载中…</view>

  <view class="top-info">
    <text class="pname">{{name}}</text>
    <text class="pmeta">{{meta}}</text>
  </view>

  <view class="bottom-bar">
    <view class="back-btn" bindtap="goBack">← 返回</view>
    <scroll-view scroll-x class="struct-bar" show-scrollbar="{{false}}">
      <view class="struct-row">
        <view wx:for="{{structures}}" wx:key="key" class="s-chip" data-key="{{item.key}}" bindtap="onToggle">
          <view class="swatch" style="background:{{item.color}}"></view>
          <text class="sname">{{item.name}}</text>
          <view class="check {{item.checked ? 'on' : ''}}"></view>
        </view>
      </view>
    </scroll-view>
    <view class="btn-mini" bindtap="onReset">复位</view>
  </view>
</view>
